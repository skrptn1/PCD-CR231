import java.util.Random;

public class lab1 {
    public static void main(String[] args) throws InterruptedException {
        // 1. Generăm tabloul comun de 100 de elemente [1..100]
        int[] mas = generateArray(100);

        // 2. Creăm două fire care aplică Condiția 1
        Runnable r1 = new Conditie1Task(mas);
        Runnable r2 = new Conditie1Task(mas);

        Thread th1 = new Thread(r1, "Th1");
        Thread th2 = new Thread(r2, "Th2");

        th1.start();
        th2.start();

        // așteptăm să termine ambele fire
        th1.join();
        th2.join();

        // 3. După ce s-au terminat firele, afișăm textul despre studenți, literă cu literă
        String text = "Studentii care au efectuat lucrarea de laborator: Popescu Ion, "
                    + "Ionescu Maria, Gherman Mihai.";
        printSlow(text, 100);
    }

    private static int[] generateArray(int n) {
        int[] a = new int[n];
        Random rand = new Random();
        for (int i = 0; i < n; i++) {
            a[i] = rand.nextInt(100) + 1; // valori 1..100
        }
        return a;
    }

    private static void printSlow(String s, int delayMs) {
        for (int i = 0; i < s.length(); i++) {
            System.out.print(s.charAt(i));
            try {
                Thread.sleep(delayMs);
            } catch (InterruptedException e) {
                // ignorăm întreruperea
            }
        }
        System.out.println();
    }
}